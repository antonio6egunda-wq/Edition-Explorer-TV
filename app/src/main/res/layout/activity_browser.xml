<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="32dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/accent"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDetalhado"
            style="@style/Button.Explorer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_seg_button"
            android:drawableStart="@drawable/ic_list_detail"
            android:drawablePadding="10dp"
            android:drawableTint="@color/selector_seg_text"
            android:text="@string/browser_detalhado"
            android:textColor="@color/selector_seg_text" />

        <Button
            android:id="@+id/btnCompacto"
            style="@style/Button.Explorer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_seg_button"
            android:drawableStart="@drawable/ic_list"
            android:drawablePadding="10dp"
            android:drawableTint="@color/selector_seg_text"
            android:text="@string/browser_compacto"
            android:textColor="@color/selector_seg_text" />

        <Button
            android:id="@+id/btnGrade"
            style="@style/Button.Explorer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_seg_button"
            android:drawableStart="@drawable/ic_grid"
            android:drawablePadding="10dp"
            android:drawableTint="@color/selector_seg_text"
            android:text="@string/browser_grade"
            android:textColor="@color/selector_seg_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnOrdenar"
            style="@style/Button.Explorer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ordenar_nome" />

        <Button
            android:id="@+id/btnEnviar"
            style="@style/Button.Explorer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enviar_n"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCabecalho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="64dp"
        android:visibility="gone">

        <View
            android:layout_width="28dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/cabecalho_nome"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:text="@string/cabecalho_tipo"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="@string/cabecalho_tamanho"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="@string/cabecalho_data"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="22sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFiles"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvClipboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/browser_dica"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>
